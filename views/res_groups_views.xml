<odoo>
  <record id="view_groups_form_inherit_inspector" model="ir.ui.view">
    <field name="name">res.groups.form.inspector</field>
    <field name="model">res.groups</field>
    <field name="inherit_id" ref="base.view_groups_form"/>
    <field name="arch" type="xml">

      <!-- Sửa tại đây: chèn sau nhóm field đầu tiên -->
       <xpath expr="//div[@name='button_box']/button[@name='action_show_all_users']" position="after">

          <button name="action_show_x_menus"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-bars">
            <field name="x_menu_count" widget="statinfo"/>
          </button>

          <button name="action_show_x_views"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-eye">
            <field name="x_view_count" widget="statinfo"/>
          </button>

          <button name="action_show_x_access_rights"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-key">
            <field name="x_access_right_count" widget="statinfo"/>
          </button>

          <button name="action_show_x_record_rules"
                  type="object"
                  class="oe_stat_button"
                  icon="fa-lock">
            <field name="x_rule_count" widget="statinfo"/>
          </button>
      </xpath>

    </field>
  </record>
</odoo>
