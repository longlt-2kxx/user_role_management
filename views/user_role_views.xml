<odoo>
    <record id="view_user_roles_list_custom" model="ir.ui.view">
        <field name="name">res.groups.list.user.roles</field>
        <field name="model">res.groups</field>
        <field name="arch" type="xml">
            <list string="User Roles" create="true" editable="bottom" multi_edit="true" open_form_view="true">
                <field name="name"/>
                <field name="all_user_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="action_user_roles" model="ir.actions.act_window">
        <field name="name">User Roles</field>
        <field name="res_model">res.groups</field>
        <field name="view_id" ref="view_user_roles_list_custom"/>
        <field name="view_mode">list,form</field>
        <field name="domain"
               eval="[('privilege_id.category_id', '=', ref('user_role_management.module_category_access_right'))]"/>
        <field name="context">{
            'search_default_user_roles_filter': 1,
            'default_privilege_id': ref('user_role_management.privilege_access_right')
            }
        </field>
    </record>

    <!-- Filter mặc định: dùng đúng external ID -->
    <!--    <record id="filter_user_roles_category" model="ir.filters">-->
    <!--        <field name="name">User Roles</field>-->
