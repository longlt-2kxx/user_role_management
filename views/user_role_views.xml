    <!--    </record>-->

    <record id="view_users_form_inherit_manual_override" model="ir.ui.view">
        <field name="name">res.users.form.inherit.manual.override</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='role']" position="after">
                <field name="x_update_additional_rights"/>
            </xpath>
        </field>
    </record>
    <record id="view_users_tree_add_user_roles" model="ir.ui.view">
        <field name="name">res.users.tree.add.user.roles</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree"/>
        <field name="arch" type="xml">
            <!-- chèn sau cột role đang có -->
            <xpath expr="//field[@name='login']" position="after">
                <field name="x_user_role_ids"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       string="User Role"/>
            </xpath>
        </field>
    </record>
    <record id="action_server_res_users_clear_role" model="ir.actions.server">
        <field name="name">Clear Role</field>
        <field name="model_id" ref="base.model_res_users"/>
        <field name="state">code</field>
        <field name="code">records.action_clear_role()</field>

        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list,form</field>
        <field name="binding_type">action</field>

        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>
    <menuitem id="menu_user_roles"
              name="User Roles"
              parent="base.menu_users"
              action="action_user_roles"
              sequence="4"
              groups="base.group_system"/>

</odoo>
